# Local backend development. Production settings belong in .env.production.
APP_NAME=pomi-backend
NODE_ENV=development
NEST_PORT=3001

DATABASE_URL=postgres://user:password@localhost:5432/pomodoro
REDIS_URL=redis://localhost:6380
JWT_SECRET=pomi-development-only-secret-never-use-in-production
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# Optional integrations are disabled when blank.
NEST_SENTRY_DSN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_HTTP_REFERER=
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_LABEL=feedback
FIREBASE_SERVICE_ACCOUNT_JSON=
APN_KEY_PATH=
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=app.pomi.community
APN_PRODUCTION=false
