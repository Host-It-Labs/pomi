{
  "name": "@pomi/backend",
  "version": "0.0.1",
  "description": "Pomi self-hosted API and realtime backend.",
  "main": "dist/src/main",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node .",
    "openapi:generate": "ts-node src/openapi.ts",
    "seed:test-user": "ts-node scripts/seed-test-user.ts",
    "seed:e2e-admins": "ts-node scripts/seed-e2e-admins.ts",
    "seed:copyme": "ts-node scripts/seed-copyme-user.ts",
    "reseed:copyme": "ts-node scripts/reseed-copyme-user.ts",
    "ensure:copyme": "ts-node scripts/ensure-copyme-user.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d data-source.ts",
    "migration:verify-history": "ts-node scripts/verify-migration-history.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d data-source.ts",
    "db:clear": "ts-node scripts/clear-test-data.ts",
    "migrate:user-action-keys": "ts-node scripts/migrate-user-action-keys.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [],
  "author": "William Guinaudie",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoHuncho/pomi.git",
    "directory": "packages/backend"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.11",
    "@pomi/shared": "workspace:*",
    "@sentry/nestjs": "^9.46.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@ts-rest/nest": "^3.52.0",
    "@types/bcrypt": "^5.0.2",
    "apn": "^2.2.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.6.0",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0",
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@ts-rest/open-api": "^3.52.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/socket.io": "^3.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.2"
  }
}
