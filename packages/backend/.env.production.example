# Copy to a private location, fill every required value, and pass it with
# `docker compose --env-file`. Never commit the completed file.
POMI_BACKEND_IMAGE=pomi-backend:local
POMI_BIND_ADDRESS=127.0.0.1
POMI_BACKEND_PORT=3000

# Required secrets.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Optional non-secret overrides.
POSTGRES_USER=pomi
POSTGRES_DB=pomi
CORS_ORIGINS=

# Optional integrations remain disabled when blank.
NEST_SENTRY_DSN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_HTTP_REFERER=
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_LABEL=feedback
FIREBASE_SERVICE_ACCOUNT_JSON=
APN_KEY_PATH=
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=app.pomi.community
APN_PRODUCTION=false
