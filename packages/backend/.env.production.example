# Copy this file to a private location, fill the required values, and pass it
# with `docker compose --env-file`. Never commit the completed file.
POMI_BACKEND_IMAGE=ghcr.io/host-it-labs/pomi-backend:latest
POMI_BIND_ADDRESS=127.0.0.1
POMI_BACKEND_PORT=3000

# Required secrets. Generate a different value for each line with:
#   openssl rand -hex 32
# Keep POSTGRES_PASSWORD unchanged when upgrading an existing database.
# Keep JWT_SECRET unchanged to preserve existing login sessions.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Optional non-secret overrides.
POSTGRES_USER=pomi
POSTGRES_DB=pomi

# Native apps use these defaults. For a hosted web frontend, append its exact
# origin without a path or trailing slash, for example:
#   CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://pomi.example.com
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Optional integrations remain disabled when blank.
# NEST_SENTRY_DSN comes from Sentry project settings > Client Keys (DSN).
NEST_SENTRY_DSN=
# OPENROUTER_API_KEY comes from https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
# Use the public origin of the app making OpenRouter requests.
OPENROUTER_HTTP_REFERER=
# Install a GitHub App with Issues: write access on the feedback repository.
# Keep the private key outside the repository and container image. The backend
# accepts raw PEM newlines, literal \n or \r\n sequences, one-line PEMs,
# optional surrounding quotes, and PKCS#8/PKCS#1 RSA base64 without PEM wrapper
# lines. For a Compose env file, double-quote values when using escaped breaks.
GITHUB_FEEDBACK_APP_ID=
GITHUB_FEEDBACK_APP_INSTALLATION_ID=
# Example: GITHUB_FEEDBACK_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_FEEDBACK_APP_PRIVATE_KEY=
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_LABEL=feedback
# Download the JSON from Firebase project settings under Service accounts >
# Generate new private key, then compact it with:
#   jq -c . /private/path/firebase-service-account.json
# Paste that command's complete one-line output here. Keep it blank to disable FCM.
FIREBASE_SERVICE_ACCOUNT_JSON=
# APNs values come from the Apple Developer portal. APN_KEY_FILE is the private
# host path of the downloaded .p8 file; APN_KEY_PATH is its container path.
# Keep these values blank to disable direct Apple push notifications.
APN_KEY_FILE=
APN_KEY_PATH=
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=app.pomi.community
APN_PRODUCTION=false
