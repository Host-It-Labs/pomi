<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_watch_launcher"
        android:label="@string/watch_app_name"
        android:theme="@style/Theme.PomiWatch"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <service
            android:name=".PomiTileService"
            android:description="@string/pomi_tile_description"
            android:exported="true"
            android:icon="@mipmap/ic_watch_launcher"
            android:label="@string/pomi_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <activity
            android:name=".AssistantActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TasksActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".IntentionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SkipActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".LoginFieldActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".WatchLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WatchFaceActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
    </application>
</manifest>
