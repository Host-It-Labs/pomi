{
  "identifier": "mobile-capability",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-size",
    "shell:default",
    "shell:allow-execute",
    "http:default",
    "notifications:default",
    "os:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-close",
    "android-battery-optimization:default",
    "google-auth:default",
    "iap:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "*"
        }
      ]
    }
  ]
}
