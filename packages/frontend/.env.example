# Frontend development defaults.
VITE_USE_HTTPS=false
VITE_RENDER_SYSTEM_TRAY_ICON=false
VITE_DEBUG_PANEL_ENABLED=true
VITE_BACKEND_URL=localhost:3001

# Optional integrations are disabled when blank.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Android emulator override. The default automatically maps localhost to
# Android's host alias.
# VITE_ANDROID_BACKEND_URL=10.0.2.2:3001

# Optional physical Wear OS wireless-debugging target.
# POMI_WATCH_ADB_ADDRESS=WATCH_IP:MAIN_PORT

# Optional development server binding.
# VITE_HOST=0.0.0.0
