# Copy this file to .env.local for local development.
# Keep file-shaped credentials under config/secrets and reference them by path.

# Core local development
APP_NAME=pomi
NEST_PORT=3000
POMI_COMPOSE_PROJECT=pomi
POMI_CURRENT_WORK_SLUG=
DATABASE_URL=postgres://user:password@localhost:5432/pomodoro
REDIS_URL=redis://localhost:6380
JWT_SECRET=pomi-development-only-secret-never-use-in-production
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
TRUST_PROXY_HOPS=0
AUTH_ATTEMPT_WINDOW_SECONDS=60
AUTH_ATTEMPT_ORIGIN_LIMIT=60
AUTH_ATTEMPT_IDENTITY_LIMIT=10
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REGISTRATION_ORIGIN_LIMIT=20
AUTH_REGISTRATION_GLOBAL_LIMIT=200
POMI_COPYME_USERNAME=copyme
POMI_COPYME_PASSWORD=copyme

# Frontend and local client development
VITE_BACKEND_URL=localhost:3000
VITE_USE_HTTPS=false
VITE_RENDER_SYSTEM_TRAY_ICON=true
VITE_DEBUG_PANEL_ENABLED=true
VITE_PROD=false
VITE_HOST=
VITE_ANDROID_BACKEND_URL=
VITE_DEV_AUTO_LOGIN_USERNAME=
VITE_DEV_AUTO_LOGIN_PASSWORD=
VITE_TEST_CONTEXT_SLUG=
VITE_SENTRY_DSN=

# Optional local integrations
NEST_SENTRY_DSN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_HTTP_REFERER=
# Product feedback App for local backend testing; scheduled Radar uses the automation profile.
GITHUB_FEEDBACK_APP_ID=4675891
GITHUB_FEEDBACK_APP_INSTALLATION_ID=155743206
GITHUB_FEEDBACK_APP_PRIVATE_KEY_PATH=config/secrets/pomi-radar.private-key.pem
GITHUB_FEEDBACK_REPOSITORY=Host-It-Labs/pomi
GITHUB_FEEDBACK_LABEL=feedback
FIREBASE_SERVICE_ACCOUNT_PATH=config/secrets/firebase-service-account.json
POMI_FIREBASE_SERVICE_ACCOUNT_PATH=config/secrets/firebase-service-account.json
POMI_GOOGLE_SERVICES_JSON_PATH=config/secrets/google-services.json
APN_KEY_PATH=
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=app.pomi.community
APN_PRODUCTION=false
