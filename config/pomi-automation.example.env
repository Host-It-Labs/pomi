# Copy this file to config/pomi-automation.env and fill in local values.
# Keep the real file mode 600 and never commit it.

# Scheduled Pomi Radar GitHub App
POMI_RADAR_GITHUB_REPOSITORY=Host-It-Labs/pomi
POMI_RADAR_SOURCE_GITHUB_REPOSITORY=NeoHuncho/pomi-private
POMI_RADAR_GITHUB_APP_ID=4675891
POMI_RADAR_GITHUB_APP_INSTALLATION_ID=155743206
# Prefer the inline PEM value. Store line breaks as literal \n
# sequences, for example: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----".
POMI_RADAR_GITHUB_APP_PRIVATE_KEY=
# Legacy local-file fallback:
# POMI_RADAR_GITHUB_APP_PRIVATE_KEY_PATH=config/secrets/pomi-radar.private-key.pem
POMI_RADAR_SOURCE_GITHUB_TOKEN=

# Sentry data used by Radar automation
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_FRONTEND_PROJECT=
SENTRY_BACKEND_PROJECT=
SENTRY_ENVIRONMENT=production
