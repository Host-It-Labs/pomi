# Copy this file to config/pomi-release.env and fill in local values.
# This profile is for local release commands and may intentionally remain
# unsigned until Apple signing credentials are available.

# Production client configuration
VITE_BACKEND_URL=
PROD_BACKEND_URL=
VITE_USE_HTTPS=true
VITE_RENDER_SYSTEM_TRAY_ICON=true
VITE_DEBUG_PANEL_ENABLED=false
VITE_PROD=true
VITE_ANDROID_BACKEND_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
RELEASE_TAG=

# Optional Android and Wear inputs
POMI_GOOGLE_SERVICES_JSON_PATH=config/secrets/google-services.json
POMI_ANDROID_KEYSTORE_PATH=config/secrets/pomi-release.jks
ANDROID_KEY_PASSWORD=
ANDROID_KEY_ALIAS=pomi
ANDROID_HOME=
ANDROID_SDK_ROOT=
POMI_WATCH_ADB_ADDRESS=

# Local backend image publication
GHCR_IMAGE=ghcr.io/host-it-labs/pomi-backend
GHCR_USERNAME=
GHCR_TOKEN=
